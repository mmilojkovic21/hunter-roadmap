{
  // Samo za editor: Playwright sam prevodi testove. Odvojeno od src/, jer testovi uvoze JSON paketa.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["."]
}
